model Certificate {
  id                String            @id @default(uuid()) @db.Char(36)
  applicationId     String            @unique @map("application_id") @db.Char(36)
  producerId        String            @map("producer_id") @db.Char(36)
  batchId           String?           @map("batch_id") @db.Char(36)
  certificateNumber String            @unique @map("certificate_number") @db.VarChar(100)
