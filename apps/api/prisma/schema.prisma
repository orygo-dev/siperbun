}

model PublicListing {
  id           String              @id @default(uuid()) @db.Char(36)
  producerId   String              @map("producer_id") @db.Char(36)
  nurseryId    String?             @map("nursery_id") @db.Char(36)
  commodityId  String              @map("commodity_id") @db.Char(36)
  varietyId    String?             @map("variety_id") @db.Char(36)
  title        String              @db.VarChar(160)
  description  String?             @db.Text
  availableQty BigInt?             @map("available_qty")
  ageMonths    Int?                @map("age_months")
  unit         String              @default("batang") @db.VarChar(30)
  priceHint    String?             @map("price_hint") @db.VarChar(100)
  status       PublicListingStatus @default(DRAFT)
  publishedAt  DateTime?           @map("published_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  producer  Producer             @relation(fields: [producerId], references: [id])
  nursery   NurseryLocation?     @relation(fields: [nurseryId], references: [id])
  commodity Commodity            @relation(fields: [commodityId], references: [id])
  variety   Variety?             @relation(fields: [varietyId], references: [id])
  photos    PublicListingPhoto[]

  @@index([status, publishedAt])
  @@index([producerId])
  @@index([commodityId])
  @@index([deletedAt])
  @@map("public_listings")
}

model PublicListingPhoto {
  id        String   @id @default(uuid()) @db.Char(36)
  listingId String   @map("listing_id") @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  caption   String?  @db.VarChar(191)
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  listing PublicListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  file    StoredFile    @relation(fields: [fileId], references: [id])

  @@index([listingId, sortOrder])
  @@map("public_listing_photos")
}

model ProducerRegistrationRequest {
  id                  String                     @id @default(uuid()) @db.Char(36)
  businessName        String                     @map("business_name") @db.VarChar(191)
  ownerName           String                     @map("owner_name") @db.VarChar(191)
  nik                 String?                    @db.VarChar(20)
  phone               String                     @db.VarChar(30)
  email               String?                    @db.VarChar(191)
  passwordHash        String?                    @map("password_hash") @db.VarChar(255)
  address             String?                    @db.Text
  nurseryAddress      String?                    @map("nursery_address") @db.Text
  landOwnershipStatus LandOwnershipStatus?       @map("land_ownership_status")
  kabupatenId         String?                    @map("kabupaten_id") @db.Char(36)
  nurseryKabupatenId  String?                    @map("nursery_kabupaten_id") @db.Char(36)
  kecamatan           String?                    @db.VarChar(100)
  desa                String?                    @db.VarChar(100)
  latitude            Decimal?                   @db.Decimal(10, 7)
  longitude           Decimal?                   @db.Decimal(10, 7)
  commodityInterest   String?                    @map("commodity_interest") @db.VarChar(255)
  notes               String?                    @db.Text
  status              ProducerRegistrationStatus @default(SUBMITTED)
  reviewedById        String?                    @map("reviewed_by_id") @db.Char(36)
  reviewedAt          DateTime?                  @map("reviewed_at")
  reviewNotes         String?                    @map("review_notes") @db.Text
  createdProducerId   String?                    @map("created_producer_id") @db.Char(36)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  kabupaten        Region?                        @relation("RegistrationOfficeKabupaten", fields: [kabupatenId], references: [id])
  nurseryKabupaten Region?                        @relation("RegistrationNurseryKabupaten", fields: [nurseryKabupatenId], references: [id])
  reviewedBy       User?                          @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
  createdProducer  Producer?                      @relation("RegistrationCreatedProducer", fields: [createdProducerId], references: [id])
  documents        ProducerRegistrationDocument[]

  @@index([status, createdAt])
  @@index([kabupatenId])
  @@index([nurseryKabupatenId])
  @@map("producer_registration_requests")
}

model ProducerRegistrationDocument {
  id             String                   @id @default(uuid()) @db.Char(36)
  registrationId String                   @map("registration_id") @db.Char(36)
  kind           RegistrationDocumentKind
  title          String                   @db.VarChar(191)
  fileId         String                   @map("file_id") @db.Char(36)
  createdAt      DateTime                 @default(now()) @map("created_at")

  registration ProducerRegistrationRequest @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  file         StoredFile                  @relation(fields: [fileId], references: [id])

  @@unique([registrationId, kind])
  @@index([registrationId])
  @@index([fileId])
  @@map("producer_registration_documents")
}

model StoredFile {
  id           String    @id @default(uuid()) @db.Char(36)
  originalName String    @map("original_name") @db.VarChar(255)
  storageName  String    @map("storage_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  size         BigInt
  sha256       String    @db.VarChar(64)
  path         String    @db.VarChar(500)
  uploadedById String?   @map("uploaded_by_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  producerDocuments     ProducerDocument[]
  nurseryDocuments      NurseryDocument[]
  seedGardenDocuments   SeedGardenDocument[]
  seedSourceDocuments   SeedSourceDocument[]
  applicationDocuments  ApplicationDocument[]
  inspectionPhotos      InspectionPhoto[]
  correctiveActions     CorrectiveAction[]
  certificateCurrent    Certificate[]                  @relation("CertificateCurrentFile")
  certificateVersions   CertificateVersion[]
  dashboardBanners      DashboardBanner[]
  publicListingPhotos   PublicListingPhoto[]
  registrationDocuments ProducerRegistrationDocument[]
  inspectionReports     InspectionReport[]
  paymentProofs         PaymentProof[]

  @@index([sha256])
  @@map("stored_files")
}
