generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  ADMIN_REVIEW
  ADMIN_REVISION_REQUIRED
  DOCUMENT_COMPLETE
  WAITING_ASSIGNMENT
  INSPECTION_SCHEDULED
  INSPECTION_IN_PROGRESS
  FIELD_REVISION_REQUIRED
  WAITING_RESULT_VALIDATION
  INSPECTION_PASSED
  INSPECTION_FAILED
  WAITING_LHP_INVOICE
  WAITING_PAYMENT
  PAYMENT_VERIFICATION
  PAYMENT_REJECTED
  PAYMENT_VERIFIED
  CERTIFICATE_ISSUED_MANUALLY
  WAITING_CERTIFICATE_SCAN
  CERTIFICATE_SCAN_UPLOADED
  COMPLETED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  SCHEDULED
  CONFIRMED
  EN_ROUTE
  INSPECTING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum CertificateStatus {
  WAITING_ISSUANCE
  ISSUED_MANUALLY
  WAITING_SCAN
  SCAN_UPLOADED
  WAITING_VERIFICATION
  ACTIVE
  REJECTED
  REPLACED
  CANCELLED
  EXPIRED
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  WAITING_VERIFICATION
  ACCEPTED
  REJECTED
  CLOSED
}

enum InvoiceStatus {
  ISSUED
  PAYMENT_SUBMITTED
  PAID
  PAYMENT_REJECTED
  CANCELLED
}

enum PaymentProofStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ProductionStatus {
  PREPARATION
  SOWING
  GROWING
  READY_FOR_INSPECTION
  UNDER_INSPECTION
  PASSED
  FAILED
  COMPLETED
  CANCELLED
}

enum ProducerStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  INACTIVE
  REJECTED
}

enum RegionType {
  PROVINSI
  KABUPATEN
  KECAMATAN
  DESA
}

enum DocumentKind {
  NIB
  KTP
  SIUP
  SURAT_TANAH
  FOTO
  SERTIFIKAT
  LAINNYA
}

enum LandOwnershipStatus {
  RENTED
  BORROWED
  OWNED
}

enum RegistrationDocumentKind {
  BUSINESS_LICENSE
  LAND_OWNERSHIP_PROOF
  NURSERY_PHOTO
  FACILITIES_PHOTO
  SOURCE_AGREEMENT
  WATER_SOURCE_PHOTO
  BUSINESS_RECOMMENDATION
  EXPERT_CERTIFICATE
  WORKFORCE_LIST
}

enum MapMarkerType {
  NURSERY_ACTIVE
  NURSERY_PROCESS
  NURSERY_FINDING
  SEED_GARDEN
}

enum PublicListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProducerRegistrationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Auth & Access ───────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(191)
  phone        String?   @db.VarChar(30)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  officeId     String?   @map("office_id") @db.Char(36)
  regionId     String?   @map("region_id") @db.Char(36)
  producerId   String?   @map("producer_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  office   Office?   @relation(fields: [officeId], references: [id])
  region   Region?   @relation(fields: [regionId], references: [id])
  producer Producer? @relation(fields: [producerId], references: [id])

  userRoles                UserRole[]
  refreshTokens            RefreshToken[]
  fieldAssignments         FieldAssignment[]             @relation("InspectorAssignments")
  createdAssignments       FieldAssignment[]             @relation("AssignmentCreator")
  fieldInspections         FieldInspection[]
  uploadedCertificates     Certificate[]                 @relation("CertificateUploader")
  verifiedCertificates     Certificate[]                 @relation("CertificateVerifier")
  notifications            Notification[]
  activityLogs             ActivityLog[]
  auditLogs                AuditLog[]
  productionLogs           ProductionLog[]
  storedFiles              StoredFile[]
  statusChanges            ApplicationStatusHistory[]
  reviewedRegistrations    ProducerRegistrationRequest[] @relation("RegistrationReviewer")
  createdInspectionReports InspectionReport[]            @relation("InspectionReportCreator")
  issuedInvoices           ApplicationInvoice[]          @relation("InvoiceIssuer")
  submittedPaymentProofs   PaymentProof[]                @relation("PaymentSubmitter")
  verifiedPaymentProofs    PaymentProof[]                @relation("PaymentVerifier")

  @@index([officeId])
  @@index([regionId])
  @@index([producerId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Master Data ─────────────────────────────────────────────────────────────

model Office {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(191)
  code      String?   @unique @db.VarChar(50)
  address   String?   @db.Text
  phone     String?   @db.VarChar(30)
  email     String?   @db.VarChar(191)
  regionId  String?   @map("region_id") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  region Region? @relation(fields: [regionId], references: [id])
  users  User[]

  @@map("offices")
}

model Region {
  id        String     @id @default(uuid()) @db.Char(36)
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(150)
  type      RegionType
  parentId  String?    @map("parent_id") @db.Char(36)
  latitude  Decimal?   @db.Decimal(10, 7)
  longitude Decimal?   @db.Decimal(10, 7)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  parent                      Region?                       @relation("RegionTree", fields: [parentId], references: [id])
  children                    Region[]                      @relation("RegionTree")
  offices                     Office[]
  users                       User[]
  producers                   Producer[]                    @relation("ProducerKabupaten")
  nurseries                   NurseryLocation[]
  seedGardens                 SeedGarden[]
  registrationRequests        ProducerRegistrationRequest[] @relation("RegistrationOfficeKabupaten")
  nurseryRegistrationRequests ProducerRegistrationRequest[] @relation("RegistrationNurseryKabupaten")

  @@index([parentId])
  @@index([type])
  @@map("regions")
}

model Commodity {
  id             String    @id @default(uuid()) @db.Char(36)
  code           String    @unique @db.VarChar(20)
  name           String    @db.VarChar(100)
  scientificName String?   @map("scientific_name") @db.VarChar(150)
  unit           String    @default("batang") @db.VarChar(30)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  varieties         Variety[]
  seedStandards     SeedStandard[]
  seedGardens       SeedGarden[]
  seedSources       SeedSource[]
  productionBatches ProductionBatch[]
  applications      CertificationApplication[]
  nurseries         NurseryLocation[]
  publicListings    PublicListing[]

  @@map("commodities")
}

model Variety {
  id          String    @id @default(uuid()) @db.Char(36)
  commodityId String    @map("commodity_id") @db.Char(36)
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(100)
  clone       String?   @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  commodity         Commodity                  @relation(fields: [commodityId], references: [id])
  seedGardens       SeedGarden[]
  seedSources       SeedSource[]
  productionBatches ProductionBatch[]
  applications      CertificationApplication[]
  publicListings    PublicListing[]

  @@unique([commodityId, code])
  @@map("varieties")
}

model SeedStandard {
  id          String   @id @default(uuid()) @db.Char(36)
  commodityId String   @map("commodity_id") @db.Char(36)
  name        String   @db.VarChar(150)
  parameter   String   @db.VarChar(100)
  minValue    Decimal? @map("min_value") @db.Decimal(12, 2)
  maxValue    Decimal? @map("max_value") @db.Decimal(12, 2)
  unit        String?  @db.VarChar(30)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  commodity Commodity @relation(fields: [commodityId], references: [id])

  @@index([commodityId])
  @@map("seed_standards")
}

// ─── Producer Domain ─────────────────────────────────────────────────────────

model Producer {
  id                  String               @id @default(uuid()) @db.Char(36)
  registrationNumber  String               @unique @map("registration_number") @db.VarChar(50)
  businessName        String               @map("business_name") @db.VarChar(191)
  businessType        String?              @map("business_type") @db.VarChar(50)
  ownerName           String               @map("owner_name") @db.VarChar(191)
  nik                 String?              @db.VarChar(20)
  nib                 String?              @db.VarChar(50)
  phone               String?              @db.VarChar(30)
  email               String?              @db.VarChar(191)
  address             String?              @db.Text
  nurseryAddress      String?              @map("nursery_address") @db.Text
  landOwnershipStatus LandOwnershipStatus? @map("land_ownership_status")
  provinceId          String?              @map("province_id") @db.Char(36)
  kabupatenId         String?              @map("kabupaten_id") @db.Char(36)
  kecamatan           String?              @db.VarChar(100)
  desa                String?              @db.VarChar(100)
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  productionCapacity  BigInt?              @map("production_capacity")
  status              ProducerStatus       @default(PENDING_VERIFICATION)
  isActive            Boolean              @default(true) @map("is_active")
  notes               String?              @db.Text
  verifiedAt          DateTime?            @map("verified_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  kabupaten Region? @relation("ProducerKabupaten", fields: [kabupatenId], references: [id])

  users                 User[]
  documents             ProducerDocument[]
  nurseries             NurseryLocation[]
  seedGardens           SeedGarden[]
  seedSources           SeedSource[]
  productionBatches     ProductionBatch[]
  applications          CertificationApplication[]
  certificates          Certificate[]
  seedDistributions     SeedDistribution[]
  labelDistributions    LabelDistribution[]
  publicListings        PublicListing[]
  registrationAsCreated ProducerRegistrationRequest[] @relation("RegistrationCreatedProducer")

  @@index([status])
  @@index([kabupatenId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("producers")
}

model ProducerDocument {
  id         String       @id @default(uuid()) @db.Char(36)
  producerId String       @map("producer_id") @db.Char(36)
  kind       DocumentKind @default(LAINNYA)
  title      String       @db.VarChar(191)
  fileId     String?      @map("file_id") @db.Char(36)
  notes      String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  producer Producer    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  file     StoredFile? @relation(fields: [fileId], references: [id])

  @@index([producerId])
  @@map("producer_documents")
}

model NurseryLocation {
  id                  String               @id @default(uuid()) @db.Char(36)
  producerId          String               @map("producer_id") @db.Char(36)
  commodityId         String?              @map("commodity_id") @db.Char(36)
  regionId            String?              @map("region_id") @db.Char(36)
  name                String               @db.VarChar(191)
  address             String?              @db.Text
  landOwnershipStatus LandOwnershipStatus? @map("land_ownership_status")
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  areaHa              Decimal?             @map("area_ha") @db.Decimal(12, 4)
  capacity            BigInt?
  waterSource         String?              @map("water_source") @db.VarChar(100)
  facilities          String?              @db.Text
  status              String               @default("ACTIVE") @db.VarChar(30)
  markerType          MapMarkerType        @default(NURSERY_ACTIVE) @map("marker_type")
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  producer          Producer                   @relation(fields: [producerId], references: [id])
  commodity         Commodity?                 @relation(fields: [commodityId], references: [id])
  region            Region?                    @relation(fields: [regionId], references: [id])
  documents         NurseryDocument[]
  productionBatches ProductionBatch[]
  applications      CertificationApplication[]
  publicListings    PublicListing[]

  @@index([producerId])
  @@index([regionId])
  @@index([status])
  @@map("nursery_locations")
}

model NurseryDocument {
  id        String       @id @default(uuid()) @db.Char(36)
  nurseryId String       @map("nursery_id") @db.Char(36)
  kind      DocumentKind @default(LAINNYA)
  title     String       @db.VarChar(191)
  fileId    String?      @map("file_id") @db.Char(36)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  nursery NurseryLocation @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  file    StoredFile?     @relation(fields: [fileId], references: [id])

  @@index([nurseryId])
  @@map("nursery_documents")
}

model SeedGarden {
  id              String    @id @default(uuid()) @db.Char(36)
  producerId      String?   @map("producer_id") @db.Char(36)
  commodityId     String    @map("commodity_id") @db.Char(36)
  varietyId       String?   @map("variety_id") @db.Char(36)
  regionId        String?   @map("region_id") @db.Char(36)
  name            String    @db.VarChar(191)
  ownerName       String?   @map("owner_name") @db.VarChar(191)
  address         String?   @db.Text
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  areaHa          Decimal?  @map("area_ha") @db.Decimal(12, 4)
  clone           String?   @db.VarChar(100)
  plantingYear    Int?      @map("planting_year")
  motherTreeCount Int?      @map("mother_tree_count")
  estimatedYield  BigInt?   @map("estimated_yield")
  decreeNumber    String?   @map("decree_number") @db.VarChar(100)
  decreeDate      DateTime? @map("decree_date") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  status          String    @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  producer    Producer?            @relation(fields: [producerId], references: [id])
  commodity   Commodity            @relation(fields: [commodityId], references: [id])
  variety     Variety?             @relation(fields: [varietyId], references: [id])
  region      Region?              @relation(fields: [regionId], references: [id])
  documents   SeedGardenDocument[]
  seedSources SeedSource[]

  @@index([producerId])
  @@index([commodityId])
  @@map("seed_gardens")
}

model SeedGardenDocument {
  id           String       @id @default(uuid()) @db.Char(36)
  seedGardenId String       @map("seed_garden_id") @db.Char(36)
  kind         DocumentKind @default(LAINNYA)
  title        String       @db.VarChar(191)
  fileId       String?      @map("file_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  seedGarden SeedGarden  @relation(fields: [seedGardenId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id])

  @@index([seedGardenId])
  @@map("seed_garden_documents")
}

model SeedSource {
  id                   String    @id @default(uuid()) @db.Char(36)
  producerId           String    @map("producer_id") @db.Char(36)
  seedGardenId         String?   @map("seed_garden_id") @db.Char(36)
  commodityId          String    @map("commodity_id") @db.Char(36)
  varietyId            String?   @map("variety_id") @db.Char(36)
  lotNumber            String    @map("lot_number") @db.VarChar(50)
  receivedAt           DateTime? @map("received_at") @db.Date
  quantity             Decimal   @db.Decimal(14, 2)
  unit                 String    @default("kg") @db.VarChar(30)
  supplier             String?   @db.VarChar(191)
  originDocumentNumber String?   @map("origin_document_number") @db.VarChar(100)
  sourceCertificateNo  String?   @map("source_certificate_no") @db.VarChar(100)
  usedQuantity         Decimal   @default(0) @map("used_quantity") @db.Decimal(14, 2)
  remainingStock       Decimal   @default(0) @map("remaining_stock") @db.Decimal(14, 2)
  verificationStatus   String    @default("PENDING") @map("verification_status") @db.VarChar(30)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  producer          Producer             @relation(fields: [producerId], references: [id])
  seedGarden        SeedGarden?          @relation(fields: [seedGardenId], references: [id])
  commodity         Commodity            @relation(fields: [commodityId], references: [id])
  variety           Variety?             @relation(fields: [varietyId], references: [id])
  documents         SeedSourceDocument[]
  productionBatches ProductionBatch[]

  @@unique([producerId, lotNumber])
  @@index([commodityId])
  @@map("seed_sources")
}

model SeedSourceDocument {
  id           String       @id @default(uuid()) @db.Char(36)
  seedSourceId String       @map("seed_source_id") @db.Char(36)
  kind         DocumentKind @default(LAINNYA)
  title        String       @db.VarChar(191)
  fileId       String?      @map("file_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  seedSource SeedSource  @relation(fields: [seedSourceId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id])

  @@index([seedSourceId])
  @@map("seed_source_documents")
}

// ─── Production ──────────────────────────────────────────────────────────────

model ProductionBatch {
  id            String           @id @default(uuid()) @db.Char(36)
  batchNumber   String           @unique @map("batch_number") @db.VarChar(50)
  producerId    String           @map("producer_id") @db.Char(36)
  nurseryId     String?          @map("nursery_id") @db.Char(36)
  seedSourceId  String?          @map("seed_source_id") @db.Char(36)
  commodityId   String           @map("commodity_id") @db.Char(36)
  varietyId     String?          @map("variety_id") @db.Char(36)
  startedAt     DateTime?        @map("started_at") @db.Date
  initialCount  BigInt           @default(0) @map("initial_count")
  grownCount    BigInt           @default(0) @map("grown_count")
  deadCount     BigInt           @default(0) @map("dead_count")
  rejectedCount BigInt           @default(0) @map("rejected_count")
  activeCount   BigInt           @default(0) @map("active_count")
  readyCount    BigInt           @default(0) @map("ready_count")
  status        ProductionStatus @default(PREPARATION)
  notes         String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  producer      Producer                   @relation(fields: [producerId], references: [id])
  nursery       NurseryLocation?           @relation(fields: [nurseryId], references: [id])
  seedSource    SeedSource?                @relation(fields: [seedSourceId], references: [id])
  commodity     Commodity                  @relation(fields: [commodityId], references: [id])
  variety       Variety?                   @relation(fields: [varietyId], references: [id])
  logs          ProductionLog[]
  applications  CertificationApplication[]
  certificates  Certificate[]
  distributions SeedDistribution[]

  @@index([producerId])
  @@index([commodityId])
  @@index([status])
  @@map("production_batches")
}

model ProductionLog {
  id          String   @id @default(uuid()) @db.Char(36)
  batchId     String   @map("batch_id") @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  loggedAt    DateTime @default(now()) @map("logged_at")
