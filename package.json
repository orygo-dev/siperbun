{
  "name": "siperbun",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter @siperbun/api --filter @siperbun/web dev",
    "build": "pnpm -r --filter @siperbun/shared --filter @siperbun/ui --filter @siperbun/api --filter @siperbun/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @siperbun/api --filter @siperbun/web test",
    "db:generate": "pnpm --filter @siperbun/api prisma:generate",
    "db:migrate": "pnpm --filter @siperbun/api prisma:migrate",
    "db:seed": "pnpm --filter @siperbun/api prisma:seed",
    "db:seed:demo-penangkar": "pnpm --filter @siperbun/api prisma:seed:demo-penangkar",
    "db:push": "pnpm --filter @siperbun/api prisma:push",
    "prisma:validate": "pnpm --filter @siperbun/api exec prisma validate",
    "postinstall": "pnpm db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "bundle-require>esbuild": "0.28.1",
      "nanoid": "3.3.18",
      "tsup>esbuild": "0.28.1"
    }
  }
}
